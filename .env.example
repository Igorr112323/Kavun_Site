# Куда складывать SQLite-базу (по умолчанию ./data/vip-service.db).
# На проде укажите путь на постоянном диске — база не должна жить в эфемерном слое.
DATABASE_PATH=./data/vip-service.db

# Публичный адрес сайта: нужен для Open Graph, sitemap и микроразметки.
# Без завершающего слэша. На проде: https://vip-service23.ru
SITE_URL=http://localhost:3000
